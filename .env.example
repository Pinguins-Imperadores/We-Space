# ==============================================================================
# We Space — Variáveis de Ambiente e Configurações (Ambiente Local & Produção)
# ==============================================================================

# Porta do Servidor API
PORT=8080

# Banco de Dados Principal (PostgreSQL 16)
DATABASE_URL=postgres://wespace_admin:dev_secret_pass_change_me@127.0.0.1:5432/wespace_core
DB_PASSWORD=dev_secret_pass_change_me

# Cache e Sessões (Redis 7)
REDIS_URL=redis://:dev_redis_pass@127.0.0.1:6379
REDIS_PASSWORD=dev_redis_pass

# Broker de Eventos (NATS JetStream)
NATS_URL=nats://127.0.0.1:4222

# Autenticação JWT RS256 (Chaves assimétricas em PEM)
# Em dev, lidas automaticamente de docs/keys/dev_private.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Servidor de Voz WebRTC Coturn (STUN/TURN) - Bypass CG-NAT Brasil
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_HMAC_SECRET=dev_turn_hmac_secret_32bytes_min!
TURN_REALM=turn.wespace.gg

# Armazenamento de Vídeo (Cloudflare R2 / MinIO Mock em dev)
R2_ACCOUNT_ID=dev_r2_account
R2_BUCKET_NAME=wespace-clips-prod
R2_ACCESS_KEY_ID=dev_access_key
R2_SECRET_ACCESS_KEY=dev_secret_access_key
