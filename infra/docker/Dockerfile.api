# Multi-Stage Build for We Space API (Fly.io GRU target)
FROM rust:1.80-alpine AS builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig make

WORKDIR /app

# Copy root workspace and manifests for dependency caching
COPY Cargo.toml Cargo.lock* ./
COPY crates/api-server/Cargo.toml crates/api-server/
COPY crates/shared-types/Cargo.toml crates/shared-types/
COPY apps/desktop/src-tauri/Cargo.toml apps/desktop/src-tauri/

# Provide minimal stubs for desktop member so headless Alpine builds the API binary cleanly
RUN mkdir -p apps/desktop/src-tauri/src && \
    echo "pub fn run() {}" > apps/desktop/src-tauri/src/lib.rs && \
    echo "fn main() {}" > apps/desktop/src-tauri/src/main.rs && \
    echo "fn main() {}" > apps/desktop/src-tauri/build.rs

# Copy server and shared sources
COPY crates/shared-types crates/shared-types
COPY crates/api-server crates/api-server
COPY docs/keys docs/keys

# Build the release binary explicitly for wespace-api
RUN cargo build --release --bin wespace-api

# Runner Image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata libssl3

WORKDIR /app

COPY --from=builder /app/target/release/wespace-api /app/wespace-api
COPY crates/api-server/migrations /app/migrations
COPY docs/keys /app/docs/keys

ENV PORT=8080
ENV RUST_LOG=info,wespace_api=debug,tower_http=info

EXPOSE 8080

CMD ["/app/wespace-api"]
